{
    // General Settings
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "include": [
        "~/.config/waybar/modules.json"
    ],

    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "active": "  ",
        "1": "  ",
        "2": "  ",
        "3": "  ",
        "4": "4",
        "5": "5",
        "6": "6",
        "7": "7",
        "8": "8",
        "9": "9",
      },
      "persistent-workspaces": {
        "*": 3
      }
    },
    // Modules Left
    "modules-left": [
        "hyprland/workspaces",
        "custom/filemanager"
    ],

    // Modules Center
    "modules-center": [
        "clock"
    ],

    // Modules Right
    "modules-right": [
        "custom/updates",
        "pulseaudio",
        "bluetooth",
        "tray",
        "network",
        "cpu",
        "memory",
        "custom/hypridle",
        "battery",
        "custom/exit"
    ]
}

